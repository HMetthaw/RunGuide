const SPREADSHEET_ID="1yp1FJxfVxJLuommDqfAFb3GPzpq7ItNaPWqUcq6IYeQ",SHEET_NAME="Wishlist";
function doPost(event){try{const input=JSON.parse(event.postData.contents||"{}");if(input.website)return response_({ok:true});if(!input.name||!input.email||!input.device||!input.frequency||input.consent!=="Ano")return response_({ok:false,error:"Neúplná přihláška"});SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(SHEET_NAME).appendRow([new Date(),input.name,input.email,input.city||"",input.device,input.frequency,input.message||"",input.consent,"Nová","Ne",""]);return response_({ok:true})}catch(error){console.error(error);return response_({ok:false,error:"Chyba při uložení"})}}
function response_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON)}
